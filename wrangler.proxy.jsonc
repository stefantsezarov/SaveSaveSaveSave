{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploy configuration for the lookup / counting proxy Worker
  // (cool-sound-6db2riskpass.stefan-tsezarov82.workers.dev).
  //
  // Cloudflare Workers Builds deploys this Worker from the repository with:
  //   npx wrangler deploy -c wrangler.proxy.jsonc
  // Before 23 Oct 2026 it was deployed by hand, so nothing tied the running
  // code to reviewed source. Every value below was copied from the live
  // Worker on 23 Oct 2026; the deployed script was identical to
  // goplus-proxy-worker.js at that date.
  "name": "cool-sound-6db2riskpass",
  "main": "goplus-proxy-worker.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "preview_urls": false,

  // Logging stays OFF. The privacy page promises that routine request
  // logging is disabled; a deploy without this block re-enabled it once
  // (found on 23 Oct 2026 at 100% sampling). proxy-config.test.js fails
  // the build if this is ever changed.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },

  "d1_databases": [
    {
      "binding": "COUNTS",
      "database_name": "savesavesavesave-counts",
      "database_id": "f478717f-596e-443e-a5e4-904f13ac513a"
    }
  ],

  // GOPLUS_APP_KEY (plain variable) and GOPLUS_APP_SECRET (secret) are set in
  // the dashboard, not here. keep_vars stops a deploy from deleting the
  // variable; secrets are never touched by a deploy.
  "keep_vars": true
}
